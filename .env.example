# ==============================================================================
# Environment Configuration Example
# ==============================================================================
# Duplicate this file as `.env` in the project root if you wish to configure
# environment variables locally.
#
# Vite requires all client-exposed environment variables to start with `VITE_`.
# ==============================================================================

# Web3Forms Contact Form Access Key
# Obtain a free access key at: https://web3forms.com/
# (Optional: If configured in .env, can be read in client code via import.meta.env.VITE_WEB3FORMS_ACCESS_KEY)
VITE_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here
